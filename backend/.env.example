# Server
PORT=5000
NODE_ENV=development

# Database (Supabase -> Project Settings -> Database -> Connection string -> URI)
# Use the "Transaction pooler" string for Render deployment
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# CORS - your frontend URL (comma separated for multiple)
CORS_ORIGIN=http://localhost:5173

# Amazon Connect integration - shared secret sent by the AWS Lambda in the x-api-key header.
# Leave empty to disable the /integrations/connect endpoints. Generate with: openssl rand -hex 32
CONNECT_API_KEY=